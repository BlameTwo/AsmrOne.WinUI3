<?xml version="1.0" encoding="utf-8" ?>

<Window
    x:Class="CoreTest.UnitTestAppWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dv="using:AsmrOne.Downloader.ViewModels"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:CoreTest"
    xmlns:m="using:AsmrOne.WinUI3.Models.AsmrOne"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CoreTest"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <i:Interaction.Behaviors>
            <i:EventTriggerBehavior EventName="Loaded">
                <i:InvokeCommandAction Command="{x:Bind ViewModel.LoadedCommand}" />
            </i:EventTriggerBehavior>
        </i:Interaction.Behaviors>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Command="{x:Bind ViewModel.ClearListCommand}" Content="清空列表" />
            <Button Command="{x:Bind ViewModel.RefreshListCommand}" Content="刷新列表" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ListView ItemsSource="{x:Bind ViewModel.Works, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:RidDetily">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Bind Id}" />
                            <TextBlock Text="******" />
                            <TextBlock Text="{x:Bind Title}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ItemsView Grid.Column="1" ItemsSource="{x:Bind ViewModel.Downloads, Mode=OneWay}">
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="dv:DownloadIItemViewModel">
                        <ItemContainer>
                            <Grid Margin="25">
                                <i:Interaction.Behaviors>
                                    <i:EventTriggerBehavior EventName="Loaded">
                                        <i:InvokeCommandAction Command="{x:Bind LoadedCommand}" />
                                    </i:EventTriggerBehavior>
                                </i:Interaction.Behaviors>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Bind DownloadKey, Mode=OneWay}" />
                                <ProgressBar
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Maximum="{x:Bind DownloadTotalSize, Mode=OneWay}"
                                    Value="{x:Bind CurrentTotalSize, Mode=OneWay}" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="{x:Bind CurrentTotalSize, Mode=OneWay}" />
                                    <TextBlock Text="----" />
                                    <TextBlock Text="{x:Bind DownloadTotalSize, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <Button Command="{x:Bind StartDownloadCommand}" Content="开始下载" />
                                    <Button Command="{x:Bind PauseCommand}" Content="暂停下载" />
                                    <Button Command="{x:Bind ResetCommand}" Content="继续下载" />
                                    <Button Command="{x:Bind StopCommand}" Content="取消下载" />
                                </StackPanel>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
            </ItemsView>
        </Grid>

    </Grid>
</Window>
