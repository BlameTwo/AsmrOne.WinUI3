<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AsmrOne.WinUI3.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AsmrOne.WinUI3.Controls"
    xmlns:convert="using:AsmrOne.WinUI3.Converters"
    xmlns:cui="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:AsmrOne.WinUI3.Views"
    xmlns:m="using:AsmrOne.WinUI3.Models.AsmrOne"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:AsmrOne.WinUI3.Models.ItemWrapper"
    xmlns:model3="using:AsmrOne.WinUI3.Models"
    xmlns:wrapper="using:AsmrOne.WinUI3.ViewModels.ItemViewModels"
    Margin="25"
    mc:Ignorable="d">
    <Page.Resources>
        <convert:OrderConverter x:Key="OrderConverter" />
        <convert:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>
    <i:Interaction.Behaviors>
        <i:EventTriggerBehavior EventName="Loaded">
            <i:InvokeCommandAction Command="{x:Bind ViewModel.LoadedCommand}" />
        </i:EventTriggerBehavior>
    </i:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <ProgressBar
            HorizontalAlignment="Stretch"
            Background="Transparent"
            IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{x:Bind ViewModel.TagTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectTagType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="m:TagType">
                                <TextBlock Text="{x:Bind Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox
                        Margin="5,0,0,0"
                        IsEnabled="{x:Bind ViewModel.LoadingEnable, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Orders, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="model3:QueryWorkOrderWrapper">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox
                        MinWidth="70"
                        MaxWidth="70"
                        Margin="10,0,0,0"
                        Content="字幕"
                        IsChecked="{x:Bind ViewModel.IsSubtitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{x:Bind ViewModel.LoadingEnable, Mode=OneWay}" />
                </StackPanel>
                <cui:TokenizingTextBox
                    x:Name="suggestBox"
                    Grid.Column="1"
                    Margin="5,-8,0,0"
                    VerticalAlignment="Center"
                    Header="{x:Null}"
                    ItemsSource="{x:Bind ViewModel.Tag, Mode=TwoWay}"
                    SuggestedItemsSource="{x:Bind ViewModel.CacheTag, Mode=OneWay}"
                    TextMemberPath="DisplayName"
                    TokenDelimiter=",">
                    <i:Interaction.Behaviors>
                        <i:EventTriggerBehavior EventName="TokenItemAdding">
                            <i:InvokeCommandAction Command="{x:Bind ViewModel.TokenAddingCommand}" />
                        </i:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                    <cui:TokenizingTextBox.SuggestedItemTemplate>
                        <DataTemplate x:DataType="model:SearchTagWrapper">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" />
                        </DataTemplate>
                    </cui:TokenizingTextBox.SuggestedItemTemplate>
                    <cui:TokenizingTextBox.TokenItemTemplate>
                        <DataTemplate x:DataType="model:SearchTagWrapper">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" />
                        </DataTemplate>
                    </cui:TokenizingTextBox.TokenItemTemplate>
                </cui:TokenizingTextBox>
            </Grid>
            <Button
                Grid.Column="1"
                Margin="5,0,0,0"
                Padding="10"
                Command="{x:Bind ViewModel.SearchCommand, Mode=OneWay}"
                CommandParameter="{x:Bind suggestBox.Text, Mode=OneWay}"
                Style="{ThemeResource TransparentButtonStyle}">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="12"
                    Glyph="&#xE721;" />
            </Button>
        </Grid>
        <controls:AdaptiveView
            Grid.Row="2"
            Margin="25,0,25,25"
            IsEnabled="{x:Bind ViewModel.LoadingEnable, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Works, Mode=OneWay}">
            <controls:AdaptiveView.ItemTemplate>
                <DataTemplate x:DataType="wrapper:DetilyItemViewModel">
                    <Grid
                        x:Name="mainGrid"
                        Margin="5"
                        CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="row1" Height="6*" />
                                <RowDefinition x:Name="row2" Height="4*" />
                            </Grid.RowDefinitions>
                            <controls:ImageControl
                                x:Name="image"
                                Grid.RowSpan="1"
                                IsHideCover="{x:Bind HideCover}"
                                Source="{x:Bind Cover}"
                                Stretch="UniformToFill" />
                            <Border
                                Margin="0,5,5,0"
                                Padding="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                CornerRadius="5"
                                Visibility="{x:Bind IsNTFS, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="R18" />
                            </Border>
                            <Border
                                Margin="0,0,5,5"
                                Padding="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                CornerRadius="5">
                                <TextBlock FontSize="12" Text="{x:Bind Duration}" />
                            </Border>
                            <Grid
                                x:Name="session"
                                Grid.Row="1"
                                Margin="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="0 0 5 5"
                                Opacity="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.ColumnSpan="2"
                                    Margin="10"
                                    FontSize="13"
                                    MaxLines="2"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="10,5,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemColorGrayTextBrush}"
                                    Text="{x:Bind Name}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Margin="10,0,5,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemColorGrayTextBrush}">
                                    <Run Text="ID:" />
                                    <Run Text="{x:Bind Id}" />
                                </TextBlock>
                                <Button
                                    Grid.Row="1"
                                    Grid.RowSpan="2"
                                    Margin="0,0,10,10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind InvokeCommand}"
                                    FontSize="12"
                                    Style="{ThemeResource TransparentButtonStyle}">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="12"
                                        Glyph="&#xE768;" />
                                </Button>
                            </Grid>

                        </Grid>
                    </Grid>
                </DataTemplate>
            </controls:AdaptiveView.ItemTemplate>
            <controls:AdaptiveView.Layout>
                <UniformGridLayout
                    ItemsJustification="Start"
                    ItemsStretch="Uniform"
                    MinColumnSpacing="2"
                    MinItemHeight="210"
                    MinItemWidth="250" />
            </controls:AdaptiveView.Layout>
        </controls:AdaptiveView>
        <PagerControl
            Grid.Row="3"
            Margin="0,0,0,15"
            HorizontalAlignment="Center"
            HorizontalContentAlignment="Center"
            ButtonPanelAlwaysShowFirstLastPageIndex="True"
            CornerRadius="5"
            DisplayMode="ButtonPanel"
            IsEnabled="{x:Bind ViewModel.LoadingEnable, Mode=OneWay}"
            NextButtonCommand="{x:Bind ViewModel.NextItemCommand}"
            NumberOfPages="{x:Bind ViewModel.MaxPageSize, Mode=OneWay}"
            PrefixText=""
            PreviousButtonCommand="{x:Bind ViewModel.ForwardItemCommand}"
            SelectedIndexChanged="PagerControl_SelectedIndexChanged"
            SuffixText="" />
    </Grid>
</Page>
